{
  "manifest_version": 3,
  "name": "PiCode",
  "version": "0.1.0",
  "description": "Send the current tab to a PiCode agent.",
  "key": "",
  "icons": {
    "16": "icons/icon-192.png",
    "32": "icons/icon-192.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-192.png"
  },
  "action": {
    "default_title": "PiCode",
    "default_icon": {
      "16": "icons/icon-192.png",
      "32": "icons/icon-192.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "sidePanel",
    "contextMenus",
    "nativeMessaging",
    "commands",
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Open the PiCode side panel"
    }
  }
}
