 {
  "ctx": "Chat",
  "id": "chat:queueSubmit",
  "default": "Ctrl+X Enter",
  "desc": "Submit the message, marked to wait its turn: while Claude is working, Claude Code queues it and never interrupts the turn. Unlike chat:submit , it submits the draft even while an autocomplete suggestion is highlighted. Requires v2.1.247 or later"
 },
 {
  "ctx": "Chat",
  "id": "chat:sendNow",
  "default": "Ctrl+Enter, Ctrl+X Ctrl+S",
  "desc": "Interrupt the running turn so your queued messages , and your draft with them, go out right away. When nothing is running, it submits the draft, and in shell mode it queues the command without interrupting. Terminals that don\u2019t report extended keys deliver Ctrl+Enter as plain Enter , so Ctrl+X Ctrl+S is the binding that works in any terminal. Requires v2.1.275 or later"
 },
 {
  "ctx": "Chat",
  "id": "chat:newline",
  "default": "Ctrl+J",
  "desc": "Insert a newline without submitting"
 },
