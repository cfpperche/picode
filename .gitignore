# Go
bin/
*.exe
*.test
coverage.out

# Frontend
# Vite output. Generated by `make web` on every build and never edited by
# hand; committing it rewrote ~133 files per UI change and turned every merge
# between parallel worktrees into hundreds of rename conflicts (ADR-0023).
internal/web/public/
# No trailing slash: `node_modules/` matches only directories, which is how a
# symlink named node_modules once got committed by `git add -A`.
node_modules
dist/
web/dist/
docs-site/.vitepress/cache/
docs-site/.vitepress/dist/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Git worktrees (AGENTS.md: isolated trees per agent)
.worktrees/

# Local
.env
.env.*
*.log
var/

# Claude Code local config + per-agent worktrees (machine-local)
.claude/

# Prompt-door staging folder written by the running app (ADR-0089); its own
# nested .gitignore hides drop/, this hides the folder itself.
.picode/

# Per-agent pi package overlays (ADR-0033, ADR-0061). PI_ROLES_AGENT /
# PI_COMPACT_AGENT point every managed agent at .pi/roles/<id>.json and
# .pi/compact/<id>.json, rewritten on each /roles or /compact-edit —
# machine-local like .claude/, never policy. The workspace layer
# (.pi/roles.json, .pi/compact.json) stays tracked.
.pi/roles/
.pi/compact/
