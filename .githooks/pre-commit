#!/usr/bin/env bash
# Belt to the reference-transaction guard: even if the root checkout ends up
# off main (an override, an older git without reference-transaction, a
# bypassed hook), feature work must not be committed from it — that is the
# state that blocks every other agent (AGENTS.md §5). ADR-0105 added the
# living-docs rules: whitespace errors stop here (they used to fail GitHub CI
# unread), CHANGELOG.md is assembled from fragments, and handoff state reaches
# main only inside a fast-forwarded branch.
#
# Escape hatch: PICODE_ALLOW_SWITCH=1 git commit …  (or --no-verify)

[ -n "$PICODE_ALLOW_SWITCH" ] && exit 0

staged() { git diff --cached --name-only --diff-filter="${1:-ACMRD}" 2>/dev/null; }
refuse() { printf '\n  %s\n' "$@" >&2; echo >&2; exit 1; }

# Content integrity for the two living docs: a parallel session writing from
# a stale worktree path has clobbered them before (a handoff landed inside
# CHANGELOG.md and vice versa). Refuse the commit when a staged version lost
# its shape, whatever branch or worktree this is.
check_shape() { # <path> <first-line prefix>
  staged | grep -qx "$1" || return 0
  first=$(git show ":$1" 2>/dev/null | head -n 1)
  case "$first" in "$2"*) return 0 ;; esac
  refuse "$1 no longer starts with $2." \
    "The staged content belongs to the wrong file — a parallel session" \
    "likely wrote into this worktree (AGENTS.md §5)." \
    "Recover with: git restore --staged --worktree $1   then re-apply your edit."
}
check_shape CHANGELOG.md "# Changelog"

# docs/handoff.md is generated and not in git (ADR-0123): board state is
# derived from git and from docs/handoff/open/<topic>.md, so a committed copy
# is either stale or a parallel-session clobber. The ignore rule keeps it out
# of `git add`; this refuses the forced one.
# ...and only for an addition or an edit: deleting the file (this ADR's own
# change) is how the tracked copy went away.
if git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -qx 'docs/handoff.md'; then
  refuse "docs/handoff.md is generated by \`make handoff\` (ADR-0123) and is not in git." \
    "Put the item in docs/handoff/open/<topic>.md (## Next / ## Debts) or in your" \
    "session note docs/handoff/<date>-<branch>.md — then run \`make handoff\`."
fi

gd=$(git rev-parse --absolute-git-dir 2>/dev/null) || exit 0
cd=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0

# A merge, rebase or cherry-pick in progress commits on its own terms.
for state in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
  [ -e "$gd/$state" ] && exit 0
done

# Whitespace errors (trailing blanks, space before tab) used to reach GitHub
# CI, where `git diff --check` failed the whole run and nobody read it.
if ! git diff --cached --check >/dev/null 2>&1; then
  git diff --cached --check 2>/dev/null | head -n 10 >&2
  refuse "Whitespace errors in the staged diff (above). Fix them; CI would have refused the push."
fi

# CHANGELOG.md is assembled from docs/changelog.d/ fragments (ADR-0105). Two
# direct edits are legitimate: the assembly, recognisable by the fragment
# deletions staged alongside it, and the release cut, which adds a
# "## [x.y.z]" heading (docs/release-process.md).
if staged | grep -qx CHANGELOG.md \
  && ! staged D | grep -q '^docs/changelog\.d/.*\.md$' \
  && ! git diff --cached -U0 -- CHANGELOG.md | grep -qE '^\+## \[[0-9]'; then
  refuse "CHANGELOG.md is assembled, not edited (ADR-0105)." \
    "Write docs/changelog.d/<branch-slug>.md with '### Added' / '### Fixed' … lines instead;" \
    "'make changelog' folds every fragment into [Unreleased] on main before a release."
fi

# A fragment that does not parse would only fail at release time, when its
# author is gone. Check the staged content now; skipped where the assembler
# is absent (a clone without scripts/, the hook self-test's throwaway repo).
if [ -f scripts/changelog-assemble.mjs ] && command -v node >/dev/null 2>&1; then
  for f in $(staged ACMR | grep '^docs/changelog\.d/.*\.md$' | grep -v '/README\.md$'); do
    err=$(git show ":$f" | node scripts/changelog-assemble.mjs --check 2>&1) \
      || refuse "$f is not a valid changelog fragment: $err" \
        "Sections are '### Added' … '### Security', each followed by '- ' lines (docs/changelog.d/README.md)."
  done
fi

if [ "$gd" = "$cd" ]; then
  branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || exit 0  # detached: not ours to judge
  if [ "$branch" = "main" ]; then
    # Handoff state and changelog fragments travel with the branch and reach
    # main by fast-forward. 65 direct "record the merge/deploy" commits in
    # three days were the prose ADR-0086 had already banned.
    if staged ACMR | grep -qE '^(docs/handoff/|docs/changelog\.d/)'; then
      refuse "Refusing to commit handoff state or changelog fragments directly on main (ADR-0105)." \
        "They belong to the branch that did the work: edit them in its worktree, then" \
        "git merge --ff-only <branch>. Deploy history is the data dir's var/deploy-log.jsonl, not prose."
    fi
    exit 0
  fi
  refuse "Refusing to commit on $branch in the repository root." \
    "The root checkout is shared; feature commits belong to a worktree:" \
    "    git worktree add .worktrees/<name> -b $branch" \
    "Then commit there. Root commits are for main only."
fi
exit 0  # linked worktree: any branch is fine
